[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = KmDeviceStateApp
  FILE_GUID                      = A0E51E2F-4B2A-4D6B-9C4E-3F1E0D8A5C01
  # DXE_DRIVER: the DXE dispatcher loads and runs it automatically at every
  # boot (no BDS boot option needed). Depex = TRUE on purpose: the driver used
  # to wait for gQcomQseecomProtocolGuid, but on socrates that protocol is
  # never installed when the SMC/TZ chain is down, so the driver never
  # dispatched and we got zero diagnostics. With TRUE it always dispatches
  # (late, after the console is up) and its entry reports the state of each
  # link (ShmBridge/SCM/Qseecom/VerifiedBoot) directly on the screen.
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 2.0
  ENTRY_POINT                    = KmDeviceStateAppEntry

[Sources]
  KmDeviceStateApp.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  QcomPkg/QcomPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  DebugLib
  BaseMemoryLib
  MemoryAllocationLib

[Depex]
  TRUE
